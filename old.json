{
  "expo": {
    "name": "Meter Tracker",
    "slug": "meter-tracker-expo",
    "version": "1.0.10",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "metertracker",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.gawenda.metertracker",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0",
            "newArchEnabled": true
          },
          "ios": {
            "deploymentTarget": "13.4",
            "newArchEnabled": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "./plugins/withAndroidStyles",
        {
          "AppTheme": {
            "parent": "Theme.Material3.Light.NoActionBar",
            "materialAlertDialogTheme": "@style/AlertDialog",
            "android:datePickerDialogTheme": "@style/MaterialDateDialog",
            "android:timePickerDialogTheme": "@style/MaterialDateDialog",
            "android:alertDialogTheme": "@style/AlertDialog"
          },
          "MaterialDateDialog": {
            "parent": "Theme.MaterialComponents.DayNight.Dialog",
            "colorControlActivated": "@color/primary",
            "android:textColor": "@color/text",
            "colorAccent": "@color/primaryContainer",
            "colorPrimary": "@color/primaryContainer",
            "colorSurface": "@color/primaryContainer",
            "android:textColorPrimary": "@color/text",
            "android:textColorPrimaryInverse": "@color/text",
            "android:textColorSecondary": "@color/textMuted",
            "android:windowBackground": "@color/card",
            "android:numbersSelectorColor": "@color/card",
            "colorOnPrimary": "#0000ff",
            "colorOnSurface": "#0000ff",
            "clockFaceBackgroundColor": "#0000ff",
            "clockHandColor": "#0000ff",
            "clockNumberTextColor": "#0000ff",
            "android:colorAccent": "#00ffff",
            "android:navigationBarColor": "#0000ff",
            "android:calendarTextColor": "#ffff00",
            "android:headerBackground": "#ffff00",
            "colorPrimaryDark": "#ff00ff",

            "android:windowLightStatusBar": "false"
          },
          "AlertDialog": {
            "parent": "Theme.MaterialComponents.DayNight.Dialog",
            "colorPrimary": "#ff0000",
            "colorOnPrimary": "#00ff00",
            "colorAccent": "#0000ff",
            "colorSecondary": "#0ff0f0",
            "colorSurface": "@color/card",
            "colorOnSurface": "@color/text",
            "tint": "#ff00ff",
            "android:tint": "#ff00ff",
            "android:background": "@color/background",
            "android:textColor": "@color/textMuted",
            "android:textColorPrimary": "#00fff0",
            "android:colorAccent": "#0fff0f",
            "android:windowBackground": "#ff0ff0",
            "android:windowLightStatusBar": "false"
          }
        }
      ],
      [
        "./plugins/withAndroidColorsNight",
        {
          "background": "#111415",
          "card": "#191C1D",
          "text": "#D4D7D8",
          "textMuted": "#a0a6a8",
          "textStatic": "#7e8385",
          "primary": "#0ea5e9",
          "primaryContainer": "#075985",
          "onPrimaryContainer": "#e0f2fe",
          "positive": "#34d399",
          "negative": "#f87171",
          "shadow": "#000000"
        }
      ],
      [
        "./plugins/withAndroidColors",
        {

          "background": "#f6fafd",
          "card": "#edf2f5",
          "text": "#171a1a",
          "textMuted": "#2f3636",
          "textStatic": "#4e5959",
          "primary": "#0284c7",
          "primaryContainer": "#0ea5e9",
          "onPrimaryContainer": "#e0f2fe",
          "positive": "#22c55e",
          "negative": "#FF5449",
          "shadow": "#000000"
        }
      ],
      [
        "./plugins/withAndroidGradle"
      ],
      "expo-localization",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "20ea4956-3406-4d9a-aaa6-119902d70601"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
