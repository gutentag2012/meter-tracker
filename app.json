{
  "expo": {
    "name": "MeterTracker",
    "slug": "meter-tracker-expo",
    "version": "1.0.13",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "metertracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.gawenda.metertracker",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 128,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera",
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "./plugins/withAndroidStyles",
        {
          "AppTheme": {
            "parent": "Theme.Material3.Light.NoActionBar",
            "android:datePickerDialogTheme": "@style/MaterialDateDialog",
            "android:timePickerStyle": "@style/MaterialTimeDialog",
            "android:alertDialogTheme": "@style/AlertDialog",
            "materialAlertDialogTheme": "@style/AlertDialog",
            "alertDialogTheme": "@style/AlertDialog",
            "colorPrimary": "@color/primary",
            "colorOnSurface": "@color/text",
            "colorError": "@color/negative",
            "colorAccent": "@color/card",
            "hintTextColor": "@color/textMuted",
            "colorOnPrimary": "@color/text",
            "colorControlActivated": "@color/primary",
            "android:textColor": "@color/text",
            "android:textColorPrimary": "@color/text",
            "android:textColorPrimaryInverse": "@color/text",
            "android:textColorSecondary": "@color/textMuted",
            "android:textColorSecondaryInverse": "@color/textMuted"
          },
          "MaterialDateDialog": {
            "parent": "Theme.AppCompat.Light.Dialog",
            "colorAccent": "@color/card",
            "colorControlActivated": "@color/primary",
            "android:textColor": "@color/text",
            "android:textColorPrimary": "@color/text",
            "android:textColorPrimaryInverse": "@color/text",
            "android:textColorSecondary": "@color/textMuted",
            "android:textColorSecondaryInverse": "@color/textMuted",
            "android:windowBackground": "@color/background",
            "android:windowLightStatusBar": "false"
          },
          "MaterialTimeDialog": {
            "parent": "android:Widget.Material.Light.TimePicker",
            "android:background": "@color/background",
            "android:headerBackground": "@color/card",
            "android:numbersBackgroundColor": "@color/card",
            "android:numbersSelectorColor": "@color/primary",
            "android:numbersTextColor": "@color/text",
            "colorControlNormal": "@color/text",
            "colorControlHighlight": "@color/text",
            "android:textColorSecondary": "@color/textMuted",
            "colorPrimary": "@color/primary",
            "colorOnSurface": "@color/text",
            "colorError": "@color/negative",
            "colorAccent": "@color/card",
            "hintTextColor": "@color/textMuted",
            "colorOnPrimary": "@color/text",
            "colorControlActivated": "@color/primary",
            "android:textColor": "@color/text",
            "android:textColorPrimary": "@color/text",
            "android:textColorPrimaryInverse": "@color/text",
            "android:textColorSecondaryInverse": "@color/textMuted",
            "android:windowLightStatusBar": "false"
          },
          "AlertDialog": {
            "parent": "Theme.AppCompat.Light.Dialog.Alert",
            "colorSurface": "@color/card",
            "colorOnSurface": "@color/text",
            "background": "@color/background",
            "android:background": "@color/background",
            "android:textColor": "@color/text",
            "android:textColorPrimary": "@color/textMuted",
            "colorPrimary": "@color/primary",
            "android:colorPrimary": "@color/primary",
            "colorAccent": "@color/primary",
            "android:colorAccent": "@color/primary",
            "colorError": "@color/negative",
            "android:colorError": "@color/negative",
            "android:windowLightStatusBar": "false"
          },
          "NegativeButtonStyle": {
            "parent": "Widget.MaterialComponents.Button.TextButton.Dialog",
            "android:textColor": "@color/negative"
          },
          "PositiveButtonStyle": {
            "parent": "Widget.MaterialComponents.Button.TextButton.Dialog",
            "android:textColor": "@color/positive"
          },
          "NeutralButtonStyle": {
            "parent": "Widget.MaterialComponents.Button.TextButton.Dialog",
            "android:textColor": "@color/primary"
          }
        }
      ],
      [
        "./plugins/withAndroidColorsNight",
        {
          "background": "#111415",
          "card": "#191C1D",
          "text": "#D4D7D8",
          "textMuted": "#a0a6a8",
          "textStatic": "#7e8385",
          "primary": "#0ea5e9",
          "primaryContainer": "#075985",
          "onPrimaryContainer": "#e0f2fe",
          "positive": "#34d399",
          "negative": "#f87171",
          "shadow": "#000000"
        }
      ],
      [
        "./plugins/withAndroidColors",
        {
          "background": "#f6fafd",
          "card": "#edf2f5",
          "text": "#171a1a",
          "textMuted": "#2f3636",
          "textStatic": "#4e5959",
          "primary": "#0284c7",
          "primaryContainer": "#0ea5e9",
          "onPrimaryContainer": "#e0f2fe",
          "positive": "#22c55e",
          "negative": "#FF5449",
          "shadow": "#000000"
        }
      ],
      [
        "./plugins/withAndroidGradle"
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Mona-Sans-Bold.ttf",
            "./assets/fonts/Mona-Sans-Medium.ttf",
            "./assets/fonts/Mona-Sans-Regular.ttf",
            "./assets/fonts/SpaceMono-Bold.ttf",
            "./assets/fonts/SpaceMono-Regular.ttf"
          ]
        }
      ],
      "expo-localization",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "20ea4956-3406-4d9a-aaa6-119902d70601"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/20ea4956-3406-4d9a-aaa6-119902d70601"
    }
  }
}
